{
  "release-type": "python",
  "changelog-type": "github",
  "pull-request-title-pattern": "chore(release): lemonpie-cli v${version}",
  "pull-request-header": "## Release Summary\nReview the proposed version bump and changelog entries below. Merge this PR when ready to publish the release.",
  "packages": {
    ".": {
      "package-name": "lemonpie-cli",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "prerelease": true,
      "versioning": "prerelease",
      "include-component-in-tag": false
    }
  }
}
